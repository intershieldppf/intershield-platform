# Área administrativa (obrigatórios para habilitar /admin)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Compra e cálculo de frete
CHECKOUT_ENABLED=false
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_ENV=sandbox

# Pedidos e conta opcional (chaves privadas nunca usam NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Pagamento pelo Checkout Pro do Mercado Pago
PAYMENTS_ENABLED=false
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_ENV=sandbox
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Métricas opcionais, ativadas somente após consentimento do visitante
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
